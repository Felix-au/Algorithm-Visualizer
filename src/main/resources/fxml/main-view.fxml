<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.algorithmvisualizer.ui.MainController"
            style="-fx-background-color: linear-gradient(to bottom, #f5f7fa 0%, #e8eef5 100%);">
   <top>
      <VBox spacing="5.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <ImageView fitHeight="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@/Logo.png" />
                     </image>
                  </ImageView>
                  <Label text="AlgoBuddy">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                     <style>-fx-text-fill: #2b4c7e;</style>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="searchField" promptText="🔍 Search algorithms..." 
                            prefWidth="350.0" 
                            style="-fx-background-color: #f8f9fa; -fx-background-radius: 20; -fx-padding: 8 15; -fx-border-color: #dee2e6; -fx-border-radius: 20; -fx-font-size: 13px;" />
               </children>
               <padding>
                  <Insets bottom="15.0" left="30.0" right="30.0" top="15.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" 
                  style="-fx-background-color: transparent; -fx-background: transparent;"
                  hbarPolicy="NEVER">
         <content>
            <VBox spacing="25.0" fx:id="mainContent">
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
               </padding>
               <children>
                  <!-- Welcome Section -->
                  <VBox spacing="8.0" alignment="CENTER">
                     <children>
                        <Label text="Choose an Algorithm Category">
                           <font>
                              <Font name="System Bold" size="26.0" />
                           </font>
                           <style>-fx-text-fill: #2b4c7e;</style>
                        </Label>
                        <Label text="Select a category to explore algorithms" style="-fx-text-fill: #6c757d;">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  
                  <!-- Category Grid -->
                  <FlowPane fx:id="categoryGrid" hgap="20.0" vgap="20.0" 
                           alignment="CENTER">
                     <!-- Categories will be added dynamically -->
                  </FlowPane>
                  
                  <!-- Selected Category Section -->
                  <VBox fx:id="algorithmSection" spacing="15.0" managed="false" visible="false">
                     <children>
                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                           <children>
                              <Button fx:id="backButton" text="← Back to Categories" 
                                     onAction="#showCategories"
                                     style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;">
                              </Button>
                              <Label fx:id="categoryTitle" text="Category Name">
                                 <font>
                                    <Font name="System Bold" size="22.0" />
                                 </font>
                                 <style>-fx-text-fill: #2b4c7e;</style>
                              </Label>
                           </children>
                        </HBox>
                        
                        <!-- Algorithm Cards Grid -->
                        <FlowPane fx:id="algorithmGrid" hgap="20.0" vgap="20.0" 
                                 alignment="CENTER_LEFT">
                           <!-- Algorithm cards will be added dynamically -->
                        </FlowPane>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="20.0" 
           style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, -2);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="updateButton" text="Check for Updates" 
                          onAction="#checkForUpdates"
                          style="-fx-background-color: #2b4c7e; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 11px;">
                  </Button>
               </children>
            </HBox>
            <Label text="Version" style="-fx-text-fill: #6c757d;">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Label fx:id="versionLabel" text="0.0" style="-fx-text-fill: #2b4c7e; -fx-font-weight: bold;">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Separator orientation="VERTICAL" prefHeight="20.0" />
            <Label text="Built with ❤️ for algorithm enthusiasts" style="-fx-text-fill: #6c757d;">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
