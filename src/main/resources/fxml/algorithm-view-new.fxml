<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.algorithmvisualizer.ui.AlgorithmViewController">
   <top>
      <VBox spacing="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
               <children>
                  <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBackToMain" text="Back to Algorithms" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;">
                     <graphic>
                        <FontIcon iconLiteral="fas-arrow-left" iconSize="14" iconColor="white" />
                     </graphic>
                  </Button>
                  <Separator orientation="VERTICAL" prefHeight="30.0" />
                  <Label fx:id="algorithmTitle" styleClass="title" text="Algorithm Name" style="-fx-text-fill: #2b4c7e;">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
               <padding>
                  <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
               </padding>
            </HBox>
            <Separator />
         </children>
      </VBox>
   </top>
   <center>
      <SplitPane dividerPositions="0.7" orientation="HORIZONTAL">
         <items>
            <!-- VISUAL SECTION (70%) -->
            <VBox fx:id="visualSection" spacing="10.0">
               <children>
                  <!-- Play Controls -->
                  <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
                     <children>
                        <Button fx:id="stepBackButton" mnemonicParsing="false" onAction="#onStepBack" text="Step Back" style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px;">
                           <graphic>
                              <FontIcon iconLiteral="fas-step-backward" iconSize="14" iconColor="white" />
                           </graphic>
                        </Button>
                        <Button fx:id="pauseButton" mnemonicParsing="false" onAction="#onPause" text="Pause" disable="true" style="-fx-background-color: #ffc107; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px;">
                           <graphic>
                              <FontIcon iconLiteral="fas-pause" iconSize="14" iconColor="white" />
                           </graphic>
                        </Button>
                        <Button fx:id="playButton" mnemonicParsing="false" onAction="#onPlay" text="Play" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;">
                           <graphic>
                              <FontIcon iconLiteral="fas-play" iconSize="14" iconColor="white" />
                           </graphic>
                        </Button>
                        <Button fx:id="stepForwardButton" mnemonicParsing="false" onAction="#onStepForward" text="Step Forward" style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 16; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px;">
                           <graphic>
                              <FontIcon iconLiteral="fas-step-forward" iconSize="14" iconColor="white" />
                           </graphic>
                        </Button>
                        <Button fx:id="resetButton" mnemonicParsing="false" onAction="#onReset" text="Reset" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px;">
                           <graphic>
                              <FontIcon iconLiteral="fas-redo-alt" iconSize="14" iconColor="white" />
                           </graphic>
                        </Button>
                        <Separator orientation="VERTICAL" prefHeight="35.0" style="-fx-padding: 0 5 0 5;" />
                        <VBox spacing="3.0" alignment="CENTER">
                           <children>
                              <Label text="Playback Speed" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #2b4c7e;" />
                              <HBox spacing="8.0" alignment="CENTER">
                                 <children>
                                    <Label text="1x" style="-fx-font-size: 10px; -fx-text-fill: #6c757d;" />
                                    <Slider fx:id="speedSlider" max="20.0" min="1.0" value="1.0" prefWidth="120.0" snapToTicks="true" majorTickUnit="1.0" minorTickCount="0" showTickMarks="false" style="-fx-cursor: hand;" />
                                    <Label text="20x" style="-fx-font-size: 10px; -fx-text-fill: #6c757d;" />
                                    <Label fx:id="speedLabel" text="1x" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2b4c7e; -fx-min-width: 45; -fx-alignment: center-right;" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
                     </padding>
                  </HBox>
                  
                  <!-- Visual Content Split -->
                  <SplitPane dividerPositions="0.5" orientation="HORIZONTAL">
                     <items>
                        <!-- Chessboard Section -->
                        <VBox fx:id="chessboardSection" spacing="10.0">
                           <children>
                              <HBox fx:id="chessboardHeaderBox" alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label text="Chessboard" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                                    <Separator />
                                 </children>
                              </HBox>
                              <VBox fx:id="chessboardLegendBox" spacing="5.0">
                                 <children>
                                    <Label text="Legend:" style="-fx-font-weight: bold;" />
                                    <HBox spacing="15.0">
                                       <children>
                                          <HBox spacing="5.0">
                                             <children>
                                                <Rectangle fx:id="queenLegend" fill="DARKRED" height="12.0" stroke="BLACK" strokeWidth="1.0" width="12.0" />
                                                <Label text="Queen" />
                                             </children>
                                          </HBox>
                                          <HBox spacing="5.0">
                                             <children>
                                                <Rectangle fx:id="conflictLegend" fill="RED" height="12.0" stroke="BLACK" strokeWidth="1.0" width="12.0" />
                                                <Label text="Conflict" />
                                             </children>
                                          </HBox>
                                          <HBox spacing="5.0">
                                             <children>
                                                <Rectangle fx:id="safeLegend" fill="WHITE" height="12.0" stroke="BLACK" strokeWidth="1.0" width="12.0" />
                                                <Label text="Safe" />
                                             </children>
                                          </HBox>
                                          <HBox spacing="5.0">
                                             <children>
                                                <Rectangle fx:id="currentLegend" fill="YELLOW" height="12.0" stroke="BLACK" strokeWidth="2.0" width="12.0" />
                                                <Label text="Current" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                              <StackPane fx:id="chessboardContainer" prefHeight="400.0" prefWidth="400.0" style="-fx-background-color: white; -fx-border-color: #333333; -fx-border-width: 2;">
                                 <children>
                                    <Label text="Chessboard will appear here" />
                                 </children>
                              </StackPane>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="5.0" top="10.0" />
                           </padding>
                        </VBox>
                        
                        <!-- Solutions Section -->
                        <VBox spacing="10.0">
                           <children>
                              <HBox fx:id="solutionsHeaderBox" alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label fx:id="solutionsHeaderLabel" text="Solutions Found" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                                    <Separator />
                                 </children>
                              </HBox>
                              <VBox fx:id="solutionsSubHeaderBox" spacing="5.0">
                                 <children>
                                    <Label fx:id="solutionsSubHeaderLabel" text="Solutions will appear here as they are found" style="-fx-font-style: italic;" />
                                  </children>
                              </VBox>
                              <ScrollPane fx:id="solutionsContainer" prefHeight="400.0" prefWidth="400.0" style="-fx-background-color: white; -fx-border-color: #333333; -fx-border-width: 2;">
                                 <content>
                                    <FlowPane fx:id="solutionsContent" hgap="10.0" vgap="10.0" prefWrapLength="360.0" alignment="CENTER">
                                       <children>
                                          <Label text="No solutions found yet" />
                                       </children>
                                       <padding>
                                          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                       </padding>
                                    </FlowPane>
                                 </content>
                              </ScrollPane>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="5.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </items>
                  </SplitPane>

                  <!-- Progress + Variables under visuals (75/25 split) -->
                  <SplitPane dividerPositions="0.75" orientation="HORIZONTAL">
                     <items>
                        <!-- Progress (75%) -->
                        <VBox spacing="5.0">
                           <children>
                              <HBox spacing="8.0" alignment="CENTER_LEFT">
                                 <children>
                                    <FontIcon iconLiteral="fas-list-ul" iconSize="16" iconColor="#2b4c7e" />
                                    <Label text="Progress Log" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2b4c7e;" />
                                 </children>
                              </HBox>
                              <TextArea fx:id="progressArea" editable="false" prefHeight="250.0" wrapText="true" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="5.0" top="0.0" />
                           </padding>
                        </VBox>
                        <!-- Variables (20%) -->
                        <VBox spacing="5.0">
                           <children>
                              <HBox spacing="8.0" alignment="CENTER_LEFT">
                                 <children>
                                    <FontIcon iconLiteral="fas-database" iconSize="16" iconColor="#2b4c7e" />
                                    <Label text="Variables" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2b4c7e;" />
                                 </children>
                              </HBox>
                              <ListView fx:id="variableList" prefHeight="250.0" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="5.0" right="10.0" top="0.0" />
                           </padding>
                        </VBox>
                     </items>
                  </SplitPane>
               </children>
            </VBox>
            
            <!-- CODE SECTION (30%) -->
            <VBox fx:id="codeSection" spacing="10.0">
               <children>
                  <!-- Parameters Section -->
                  <VBox spacing="5.0">
                     <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                           <children>
                              <FontIcon iconLiteral="fas-sliders-h" iconSize="16" iconColor="#2b4c7e" />
                              <Label text="Parameters" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2b4c7e;" />
                           </children>
                        </HBox>
                        <!-- Two-row parameters layout to support Selection Sort input -->
                        <VBox spacing="6.0">
                           <children>
                              <!-- Row 1: Size -->
                              <HBox spacing="10.0">
                                 <children>
                                    <Label fx:id="paramSizeLabel" text="Board size and number of queens (N):" />
                                    <Spinner fx:id="paramBoardSizeSpinner" editable="true" initialValue="4" max="50" min="1" prefWidth="90.0" />
                                    <Label fx:id="paramTargetLabel" text="Number of Queens:" visible="false" managed="false" />
                                    <Spinner fx:id="paramNumQueensSpinner" editable="true" initialValue="4" max="10" min="1" prefWidth="90.0" visible="false" managed="false" />
                                    <Region HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <!-- Row 2: Elements -->
                              <VBox spacing="6.0">
                                 <children>
                                    <Label fx:id="paramElementsLabel" text="Value of elements:" />
                                    <!-- Selection Sort will use this FlowPane; default hidden for others -->
                                    <FlowPane fx:id="paramElementsBox" hgap="6.0" vgap="6.0" visible="false" managed="false" />
                                    <!-- Backward-compatible CSV field (Selection Sort will hide this) -->
                                    <TextField fx:id="paramElementsField" promptText="e.g. 5, 3, 8, 4, 2" prefWidth="220.0" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <Button fx:id="paramRandomizeButton" text="Randomize" style="-fx-background-color: #7b68ee; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 6 14; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11px;">
                                             <graphic>
                                                <FontIcon iconLiteral="fas-random" iconSize="12" iconColor="white" />
                                             </graphic>
                                          </Button>
                                          <Button fx:id="paramApplyButton" text="Apply" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 6 18; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11px;">
                                             <graphic>
                                                <FontIcon iconLiteral="fas-check" iconSize="12" iconColor="white" />
                                             </graphic>
                                          </Button>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  
                  
                  <!-- Algorithm Code Section -->
                  <VBox spacing="5.0">
                     <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                           <children>
                              <FontIcon iconLiteral="fas-code" iconSize="16" iconColor="#2b4c7e" />
                              <Label text="Algorithm Code" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2b4c7e;" />
                           </children>
                        </HBox>
                        <!-- Language Selector and Execute Button -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                           <children>
                              <Label text=">" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                              <ComboBox fx:id="languageSelector" prefWidth="140.0" 
                                        style="-fx-font-size: 12px; 
                                               -fx-background-color: white;
                                               -fx-border-color: #e0e0e0;
                                               -fx-border-radius: 6;
                                               -fx-background-radius: 6;
                                               -fx-padding: 6 12;" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="openEditorButton" 
                                      style="-fx-background-color: #667eea; 
                                             -fx-text-fill: white; 
                                             -fx-background-radius: 6; 
                                             -fx-padding: 8 12; 
                                             -fx-cursor: hand; 
                                             -fx-font-size: 11px;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 2);">
                                 <graphic>
                                    <FontIcon iconLiteral="fas-external-link-alt" iconSize="14" iconColor="white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="Open Full-Screen Code Editor" />
                                 </tooltip>
                              </Button>
                              <Button fx:id="themeToggleButton" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 12; -fx-cursor: hand; -fx-font-size: 11px;">
                                 <graphic>
                                    <FontIcon fx:id="themeToggleIcon" iconLiteral="fas-sun" iconSize="14" iconColor="white" />
                                 </graphic>
                                 <tooltip>
                                    <Tooltip text="Toggle Light/Dark Mode" />
                                 </tooltip>
                              </Button>
                              <Button fx:id="executeButton" text="Run" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 11px;">
                                 <graphic>
                                    <FontIcon iconLiteral="fas-play-circle" iconSize="14" iconColor="white" />
                                 </graphic>
                              </Button>
                           </children>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </HBox>
                        <!-- Code Area Container (CodeArea will be added programmatically) -->
                        <StackPane fx:id="codeAreaContainer" prefHeight="520.0" prefWidth="300.0">
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </StackPane>
                     </children>
                  </VBox>
                  
                  <!-- Step Description -->
                  <VBox spacing="5.0">
                     <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                           <children>
                              <FontIcon iconLiteral="fas-info-circle" iconSize="16" iconColor="#2b4c7e" />
                              <Label text="Current Step" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2b4c7e;" />
                           </children>
                        </HBox>
                        <TextArea fx:id="stepDescription" editable="false" prefHeight="80.0" prefWidth="300.0" wrapText="true" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </items>
      </SplitPane>
   </center>
</BorderPane>
